# FOMO Shield — Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values for local development.
# The real `.env` is gitignored — never commit secrets.
#
# In CI, `.env` is generated from GitHub Secrets (see .github/workflows/release.yml).

# scanco-backend (Finnhub proxy/cache)
BACKEND_BASE_URL=https://your-backend.example.com
BACKEND_API_KEY=your_backend_api_key

# Finnhub API key (used for market data)
FINNHUB_API_KEY=your_finnhub_api_key
