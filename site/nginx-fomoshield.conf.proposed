# Proposed replacement for /etc/nginx/sites-enabled/fomoshield-app.
#
# Only two things change from the live config (saved next to this file as
# nginx-fomoshield.conf.current, pulled 2026-09-27):
#
#   1. `location = /` now serves the landing page. It is an exact-match
#      location, so the catch-all `location / { return 404; }` below still
#      404s every other unknown path exactly as it does today.
#   2. `location /assets/` serves the landing page's CSS, JS and images.
#      Without it those requests fall through to the catch-all and 404 —
#      which is why dropping index.html in alone would render an unstyled,
#      image-less page.
#
# The four legal-page locations are untouched, byte for byte.

server {
    server_name fomoshield.app www.fomoshield.app;
    root /var/www/fomoshield-app;

    location = / {
        try_files /index.html =404;
    }
    location /assets/ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    location /privacy {
        try_files /privacy/index.html =404;
    }
    location /terms {
        try_files /terms/index.html =404;
    }
    location /delete-account {
        try_files /delete-account/index.html =404;
    }
    location /premium {
        try_files /premium/index.html =404;
    }
    location / {
        return 404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/fomoshield.app/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/fomoshield.app/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = www.fomoshield.app) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = fomoshield.app) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name fomoshield.app www.fomoshield.app;
    return 404; # managed by Certbot

}
